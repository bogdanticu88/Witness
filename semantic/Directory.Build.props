<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CA1031: the protocol loop must turn any analysis exception into an error response. -->
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1848;CA2007;CA1305;CA1307;CA1310;CA1309;CA1062;CA1716;CA1819;CA1002;CA1024;CA1822;CA1852;CA1859;CA1868</NoWarn>
  </PropertyGroup>
</Project>
